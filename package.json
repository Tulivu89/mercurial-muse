{
  "name": "mercurial-muse",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "adventure",
    "studio"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build -w adventure && npm run build -w studio",
    "dev:all": "npm run dev:all -w adventure",
    "dev:studio": "npm run dev -w studio"
  }
}
